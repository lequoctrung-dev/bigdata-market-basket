  {
    "id": "A:P247",
    "text": "QUI ĐỊNH THỂ THỨC TRÌNH BÀY",
    "style": null,
    "pageBreakBefore": true,
    "renderedBreaks": 1
  },
  {
    "id": "A:P248",
    "text": "1. Yêu cầu chung",
    "style": null,
    "pageBreakBefore": false,
    "renderedBreaks": 0
  },
  {
    "id": "A:P249",
    "text": "Tất cả nội dung đều sử dụng font Times New Roman.",
    "style": null,
    "pageBreakBefore": false,
    "renderedBreaks": 0
  },
  {
    "id": "A:P250",
