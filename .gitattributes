# Normalize text on future Git operations; binary sources remain binary.
* text=auto
*.md text eol=lf
*.py text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
*.docx binary
*.pptx binary
*.xlsx binary
*.xls binary
*.pdf binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
